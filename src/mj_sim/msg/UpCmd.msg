# UpCmd - high-level velocity command from Xbox controller
float32 linear_x       # forward speed (m/s)
float32 linear_y       # lateral speed (m/s)
float32 angular_z      # angular speed (rad/s)
int32   policy_mode    # policy mode selector
bool    ac_a           # A button
bool    ac_b           # B button
bool    ac_x           # X button
bool    ac_y           # Y button
