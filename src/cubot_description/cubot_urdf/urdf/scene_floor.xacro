<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Floor: large flat box at ground level, provides collision surface -->
  <xacro:macro name="scene_floor" params="parent">
    <link name="floor_link">
      <visual>
        <origin xyz="0 0 -0.005" rpy="0 0 0"/>
        <geometry><box size="3.0 3.0 0.01"/></geometry>
        <material name="Floor"><color rgba="0.6 0.6 0.6 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 -0.005" rpy="0 0 0"/>
        <geometry><box size="3.0 3.0 0.01"/></geometry>
      </collision>
    </link>
    <joint name="floor_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="floor_link"/>
    </joint>
  </xacro:macro>
</robot>
