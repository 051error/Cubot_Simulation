<?xml version="1.0"?>
<robot name="floor">
  <link name="world"/>
  <link name="ground">
    <visual>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
      <geometry><box size="3.0 3.0 0.01"/></geometry>
      <material name="FloorColor"><color rgba="0.4 0.4 0.45 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
      <geometry><box size="3.0 3.0 0.01"/></geometry>
    </collision>
  </link>
  <joint name="world_to_ground" type="fixed">
    <parent link="world"/>
    <child link="ground"/>
  </joint>
</robot>
